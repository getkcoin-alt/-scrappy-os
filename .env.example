# Scrappy OS example configuration.
#
# Copy to `.env` and edit. `.env` is git-ignored; never commit real credentials.
#   cp .env.example .env
#
# Every value below is optional - Scrappy OS boots with safe defaults and the
# deterministic `mock` provider so you can evaluate it without any API key.

# ---------------------------------------------------------------------------
# Model routing
# ---------------------------------------------------------------------------
# Which provider performs inference: mock | openai | ollama
SCRAPPY_MODEL_PROVIDER=mock
# Model name passed to the provider (ignored by `mock`).
SCRAPPY_MODEL=gpt-4o-mini
# Seconds before an inference request is abandoned.
SCRAPPY_MODEL_TIMEOUT_SECONDS=60

# OpenAI-compatible provider (OpenAI, vLLM, LiteLLM, Together, Groq, ...).
# The key is read from the environment and is never written to logs or audit.
OPENAI_API_KEY=
SCRAPPY_OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama / local provider.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ---------------------------------------------------------------------------
# Storage and workspace
# ---------------------------------------------------------------------------
# Durable state: audit log, episodic memory, approvals.
SCRAPPY_DATA_DIR=~/.local/share/scrappy-os
# The only directory tools may write to by default.
SCRAPPY_WORKSPACE=~/.local/share/scrappy-os/workspace
# Extra directories tools may READ from, comma-separated.
# Keep this tight; everything outside is denied.
SCRAPPY_ALLOWED_READ_ROOTS=/etc,/proc,/sys,/var/log,/usr/share

# ---------------------------------------------------------------------------
# Orchestration limits (these are what stop a runaway agent)
# ---------------------------------------------------------------------------
SCRAPPY_MAX_PLAN_STEPS=12
SCRAPPY_MAX_REPLANS=2
SCRAPPY_MAX_TASK_SECONDS=300
SCRAPPY_MAX_CONSECUTIVE_TOOL_FAILURES=3
SCRAPPY_MAX_MODEL_CALLS=24

# ---------------------------------------------------------------------------
# Policy
# ---------------------------------------------------------------------------
# When false, PRIVILEGED and DESTRUCTIVE operations are denied outright rather
# than raised as approval requests. Useful for unattended deployments.
SCRAPPY_ALLOW_APPROVALS=true
# Minutes an approval request stays valid before it expires.
SCRAPPY_APPROVAL_TTL_MINUTES=15
# Shell executables that may run at all. Empty list = shell tool disabled.
SCRAPPY_SHELL_ALLOWLIST=ls,cat,head,tail,grep,find,df,du,free,uptime,ps,systemctl,journalctl,uname,hostname,id,which,stat,wc,date,nginx
# Never runnable, even with approval.
SCRAPPY_SHELL_DENYLIST=rm,dd,mkfs,shutdown,reboot,halt,poweroff,chown,chmod,passwd,useradd,userdel,visudo,sudo,su
SCRAPPY_SHELL_TIMEOUT_SECONDS=30
SCRAPPY_SHELL_MAX_OUTPUT_BYTES=65536

# ---------------------------------------------------------------------------
# Outbound HTTP tool
# ---------------------------------------------------------------------------
SCRAPPY_HTTP_ENABLED=true
SCRAPPY_HTTP_TIMEOUT_SECONDS=15
SCRAPPY_HTTP_MAX_BYTES=1048576
SCRAPPY_HTTP_MAX_REDIRECTS=3
# Leave false unless you truly need the agent reaching RFC1918 / link-local
# addresses. `true` re-opens the cloud-metadata SSRF path.
SCRAPPY_HTTP_ALLOW_PRIVATE_NETWORKS=false

# ---------------------------------------------------------------------------
# API / runtime
# ---------------------------------------------------------------------------
# Local-only by default. Do not expose without an authenticating proxy.
SCRAPPY_API_HOST=127.0.0.1
SCRAPPY_API_PORT=8787
SCRAPPY_HEARTBEAT_SECONDS=30
SCRAPPY_LOG_LEVEL=INFO
# json | console
SCRAPPY_LOG_FORMAT=console
